import java.util.Arrays;

public class SortArray {
    public static int[] sortIntegers(int[] array) {
        Arrays.sort(array);
        return array;
    }

    public static void main(String[] args) {
        int[] numbers = {4, 3, 2, 1};
        System.out.println(Arrays.toString(sortIntegers(numbers))); // Expected: [1, 2, 3, 4]
    }
}
